rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasTeacherLink(studentId, teacherId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teacherLinks/$(studentId + '_' + teacherId));
    }

    function teacherCodeBelongsTo(code, teacherId) {
      return exists(/databases/$(database)/documents/teacherCodes/$(code))
        && get(/databases/$(database)/documents/teacherCodes/$(code)).data.teacherId == teacherId
        && get(/databases/$(database)/documents/teacherCodes/$(code)).data.active == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid)
        || hasTeacherLink(uid, request.auth.uid);
      allow create: if isOwner(uid)
        && request.resource.data.ownerId == uid
        && request.resource.data.profileType in ['personal', 'student', 'teacher'];
      allow update: if isOwner(uid)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.profileType == resource.data.profileType
        && request.resource.data.teacherCode == resource.data.teacherCode
        && request.resource.data.studentIds == resource.data.studentIds;
      allow delete: if false;
    }

    match /teacherCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && profile(request.auth.uid).profileType == 'teacher'
        && profile(request.auth.uid).teacherCode == code
        && request.resource.data.active == true;
      allow update, delete: if signedIn()
        && resource.data.teacherId == request.auth.uid;
    }

    match /teacherLinks/{linkId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.teacherId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId is string
        && request.resource.data.teacherId != request.auth.uid
        && request.resource.data.teacherCode is string
        && linkId == request.auth.uid + '_' + request.resource.data.teacherId
        && teacherCodeBelongsTo(
          request.resource.data.teacherCode,
          request.resource.data.teacherId
        );
      allow update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || hasTeacherLink(resource.data.ownerId, request.auth.uid));
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /folders/{folderId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || (request.auth.uid in resource.data.sharedWithAccountIds));
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /pages/{pageId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || (resource.data.private == false
            && request.auth.uid in resource.data.sharedWithAccountIds)
          || (resource.data.private == false
            && profile(resource.data.ownerId).sharePersonalPagesWithTeacher == true
            && request.auth.uid in profile(resource.data.ownerId).teacherIds));
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /files/{fileId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || (resource.data.sharedWithAccountIds != null
            && request.auth.uid in resource.data.sharedWithAccountIds)
          || (resource.data.subjectVisibleToTeacher == true
            && hasTeacherLink(resource.data.ownerId, request.auth.uid)));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize >= 0
        && request.resource.data.fileSize <= 52428800;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if signedIn()
        && (resource.data.teacherId == request.auth.uid
          || request.auth.uid in resource.data.assigneeIds);
      allow create: if signedIn()
        && profile(request.auth.uid).profileType == 'teacher'
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.teacherId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.teacherId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.teacherId == request.auth.uid);
      allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    match /shares/{shareId} {
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.active == true
          || request.auth.uid in resource.data.accountIds);
      allow create, update, delete: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
